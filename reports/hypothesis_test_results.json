{
  "is_weekend_discharge": {
    "description": "Weekend vs Weekday Discharge",
    "bivariate_test": {
      "hypothesis": "Independence between is_weekend_discharge and readmitted_30d",
      "sample_size": 11511,
      "chi2_statistic": 0.7188,
      "degrees_of_freedom": 1,
      "p_value": 0.3965322557949892,
      "significance_level": 0.05,
      "statistically_significant": false,
      "odds_ratio": 0.9035,
      "odds_ratio_95_ci": [
        0.7248,
        1.1263
      ],
      "fisher_exact_p_value": 0.3788197558526102,
      "cramers_v": 0.0079
    },
    "adjusted_multivariate_test": {
      "formula": "readmitted_30d ~ is_weekend_discharge + anchor_age + charlson_age_adjusted_score + los_days + prior_admissions_count",
      "covariates_controlled": [
        "anchor_age",
        "charlson_age_adjusted_score",
        "los_days",
        "prior_admissions_count"
      ],
      "timing_coefficient": -0.0986,
      "timing_p_value": 0.380541985327432,
      "adjusted_odds_ratio": 0.9061,
      "adjusted_95_ci": [
        0.7268,
        1.1296
      ],
      "pseudo_r_squared": 0.0012
    }
  },
